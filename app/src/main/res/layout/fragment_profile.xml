<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tv_hello"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Chào bạn!"
            android:textSize="26sp" android:textStyle="bold"
            android:textColor="@color/text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="20dp"
            android:gravity="center"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/tv_badge"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🌱 Newbie"
                android:textSize="32sp" android:textStyle="bold"
                android:textColor="@color/gold" />

            <TextView
                android:id="@+id/tv_badge_desc"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Bắt đầu hành trình"
                android:textSize="14sp"
                android:textColor="@color/text_dim"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tv_next_goal"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Còn 10 từ nữa lên Script"
                android:textSize="14sp"
                android:textColor="@color/accent_light"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_streak"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🔥 Streak: 0 ngày"
            android:textSize="20sp"
            android:textColor="@color/text"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tv_stats"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@color/text_dim"
            android:gravity="center"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btn_pin_widget"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="📌 Thêm widget ra màn hình chính"
            android:background="@drawable/btn_primary"
            android:textColor="#FFFFFF"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/btn_reset"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Làm lại onboarding (test)"
            android:background="@drawable/btn_ghost"
            android:textColor="@color/text_dim"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</ScrollView>
