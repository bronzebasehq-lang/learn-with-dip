<?xml version="1.0" encoding="utf-8"?>
<!-- Widget v4.2: cỡ Mimo 2x2 (180x180dp), mascot TO trên widget, caption đậm + streak kiểu Mimo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="8dp">

    <!-- Mascot TO (110dp) — chỉ còn mascot ở widget, đã bỏ khỏi app -->
    <ImageView
        android:id="@+id/w_mascot"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:src="@drawable/mascot_sleepy"
        android:contentDescription="Dip" />

    <TextView
        android:id="@+id/w_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Time to learn!"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/w_streak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="🔥 STREAK 0"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#FDE68A"
        android:gravity="center" />

</LinearLayout>
